<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jdjv.smsbot">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="32" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <application
        android:allowBackup="true"
        android:label="SmsBat"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".SmsReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".SmsBotService"
            android:exported="false" />

        <activity
            android:name=".JobVisionActivity"
            android:exported="false"
            android:label="JobVision Bot" />

        <activity
            android:name=".CrashLogActivity"
            android:exported="false"
            android:label="Crash Log" />

        <activity
            android:name=".ContactDetailActivity"
            android:exported="false"
            android:label="جزئیات مکالمه" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".RubikaLoginActivity"
            android:exported="false"
            android:label="ورود روبیکا" />

        <service
            android:name=".RubikaService"
            android:exported="false" />

    </application>
</manifest>
